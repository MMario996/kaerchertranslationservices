{
  "name": "kaerchertranslationservices",
  "private": true,
  "version": "1.0.0",
  "description": "Kärcher Translation Services portal (Google Apps Script web app).",
  "scripts": {
    "test": "node tests/run-all.js",
    "test:ui": "node --test --test-concurrency=1 tests-ui/render.test.js",
    "preview": "node tools/build-preview.js > preview.html",
    "build:kb": "node tools/build-kb.js",
    "lint": "eslint .",
    "check": "node tools/check-structure.js && node tools/check-encoding.js",
    "check:structure": "node tools/check-structure.js",
    "ci": "npm run lint && npm run check && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "marked": "^14.1.4",
    "playwright": "^1.56.1"
  }
}
