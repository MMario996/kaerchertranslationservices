/** Admin-Woerterbuch fuer eine Sprache (Fallback Englisch). Nur fuer Admins / Admin-Light. */
function apiGetAdminI18n(lang) {
  var caller = getUserEmail_();
  if (!isAdmin_(caller) && !getAdminLightSubtabs_(caller).length) return null;
  return { lang: lang, dict: ADMIN_I18N_[lang] || ADMIN_I18N_.en, en: ADMIN_I18N_.en };
}
